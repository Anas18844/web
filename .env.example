# =============================================================================
# Copy to .env.local for development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.
# =============================================================================

# --- Site -------------------------------------------------------------------
# ⚠️ OPEN DECISION: the final domain is not settled yet (roadmap §2.1 #1).
# Leave unset to fall back to the Vercel URL. Do not publish links externally
# until the domain is decided.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (server-side only — never expose the service role key) ---------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact ----------------------------------------------------------------
# International format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=201039356737

# --- Official channels ------------------------------------------------------
# All of these already have correct defaults hardcoded in src/content/site.ts,
# so the site works without them. Set one only to OVERRIDE a default.
# NEXT_PUBLIC_EMAIL=
# NEXT_PUBLIC_YOUTUBE_URL=
# NEXT_PUBLIC_LINKEDIN_URL=
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_TIKTOK_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=

# Telegram has no default — planned but not created yet.
NEXT_PUBLIC_TELEGRAM_URL=

# --- Automation (n8n / Frappe) ----------------------------------------------
# Receives each lead so the WhatsApp confirmation goes out. If unset, leads are
# still saved — the site never loses a lead because automation is down.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
